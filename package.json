{
  "name": "hanyeong-ieum-dictionary",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "test": "npm run test:node && npm run test:worker",
    "test:node": "node --test test/*.test.mjs",
    "test:worker": "WRANGLER_LOG_PATH=/tmp/hanyeong-ieum-wrangler.log WIKIMEDIA_USER_AGENT='HanyeongIeumTest/1.0 (https://example.test/contact)' vitest run",
    "check": "tsc --noEmit && node --check src/dictionary-api.js && node --check src/handler.js && node --check src/worker.js && node --check public/app.js && node --check public/dictionary-parser.js",
    "verify": "npm run cf-typegen:check && npm test && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "linkedom": "^0.18.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
