rdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=15631&nation=eng&nationCode=6"},{"id":"krdict:45583:1","headword":"누다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"똥이나 오줌을 몸 밖으로 내보내다.","englishExpression":"evacuate; defecate","englishDescription":"To discharge urine or excrement from the body.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=45583&nation=eng&nationCode=6"},{"id":"krdict:46971:1","headword":"대피하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"위험을 피해 잠깐 안전한 곳으로 가다.","englishExpression":"evacuate; take shelter","englishDescription":"To go to a safe place for a short stay away from danger.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=46971&nation=eng&nationCode=6"},{"id":"krdict:59196:1","headword":"배설하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"생물체가 영양소를 섭취한 후 생긴 노폐물을 몸 밖으로 내보내다.","englishExpression":"excrete; evacuate","englishDescription":"For an organism to discharge waste matter that formed after taking in nutrients.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=59196&nation=eng&nationCode=6"},{"id":"krdict:81900:1","headword":"철수하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"있던 곳에서 시설이나 장비 등을 거두어 가지고 물러나다.","englishExpression":"evacuate; withdraw","englishDescription":"To gather up the equipment, supplies, etc., and leave a place where one has been stationed.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=81900&nation=eng&nationCode=6"},{"id":"krdict:85649:1","headword":"철수시키다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"있던 곳에서 시설이나 장비 등을 거두어 가지고 물러나게 하다.","englishExpression":"evacuate; withdraw; pull back","englishDescription":"To make people gather up their equipment, supplies, etc., and leave a place where they have been stationed.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=85649&nation=eng&nationCode=6"},{"id":"krdict:88094:1","headword":"후송하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"전투가 벌어지고 있는 곳에서 부상자, 물자, 포로 등을 뒤에 있는 지역으로 보내다.","englishExpression":"evacuate; transfer","englishDescription":"To transport the wounded, supplies, prisoners, etc., away from the battlefront back to the area at the rear.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=88094&nation=eng&nationCode=6"}],"expropriate":[{"id":"krdict:64632:1","headword":"수용하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"본래 개인의 소유였던 것을 국가나 공공 기관이 거두어들여 사용하다.","englishExpression":"expropriate","englishDescription":"For the government or a public institution to take and use something that was originally the property of an individual.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=64632&nation=eng&nationCode=6"}],"fart":[{"id":"krdict:37796:1","headword":"뀌다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"방귀를 몸 밖으로 내보내다.","englishExpression":"fart","englishDescription":"To let out a fart out of one's body.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=37796&nation=eng&nationCode=6"},{"id":"krdict:57843:1","headword":"방귀","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"몸속에서 항문을 통해 몸 밖으로 나오는 고약한 냄새가 나는 기체.","englishExpression":"fart","englishDescription":"A foul-smelling gas in the body that is expelled through the anus.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=57843&nation=eng&nationCode=6"}],"goreoteut":[{"id":"krdict:91468:1","headword":"고렇듯","partOfSpeech":"품사 없음","partOfSpeechKo":"품사 없음","definitionKo":"‘고러하듯’이 줄어든 말.","englishExpression":"goreoteut","englishDescription":"An abbreviated word for '고러하듯' (a conjugated form of '고러하다' (be so)).","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=91468&nation=eng&nationCode=6"}],"immediately":[{"id":"krdict:16485:2","headword":"썩","partOfSpeech":"