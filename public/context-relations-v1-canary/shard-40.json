{"version":"context-relations-v1-canary","words":{"absolute":[{"id":"krdict:31703:1","headword":"절대적","partOfSpeech":"determiner","partOfSpeechKo":"관형사","definitionKo":"아무런 조건이나 제약이 붙지 않는.","englishExpression":"absolute; complete","englishDescription":"Being with no conditions or constraints imposed.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=31703&nation=eng&nationCode=6"},{"id":"krdict:31703:2","headword":"절대적","partOfSpeech":"determiner","partOfSpeechKo":"관형사","definitionKo":"비교하거나 상대될 만한 것이 없는.","englishExpression":"absolute","englishDescription":"Incomparable or unmatched.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=31703&nation=eng&nationCode=6"},{"id":"krdict:68633:2","headword":"온전하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"잘못된 것이 없이 완벽하거나 올바르다.","englishExpression":"perfect; absolute","englishDescription":"Perfect or accurate without any flaw.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=68633&nation=eng&nationCode=6"},{"id":"krdict:70484:1","headword":"어련하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"걱정하지 않아도 될 만큼 잘될 것이 분명하다.","englishExpression":"definite; certain; absolute","englishDescription":"Making sure that there is no need to worry because things will turn out fine.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=70484&nation=eng&nationCode=6"}],"complimentary":[{"id":"krdict:15324:1","headword":"무료","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"요금이 없음.","englishExpression":"free; no charge; complimentary","englishDescription":"A state of charging nothing.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=15324&nation=eng&nationCode=6"},{"id":"krdict:24128:1","headword":"공짜배기","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"(속된 말로) 공짜.","englishExpression":"complimentary; for free; gratis","englishDescription":"(slang) Free of charge.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=24128&nation=eng&nationCode=6"}],"fortunate":[{"id":"krdict:40537:1","headword":"다복하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"복이 많다.","englishExpression":"fortunate","englishDescription":"Having much luck.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=40537&nation=eng&nationCode=6"}],"hoop":[{"id":"krdict:37548:1","headword":"굴렁쇠","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"테두리에 있는 홈에 막대를 끼워 굴리면서 노는, 쇠로 만든 둥근 모양의 장난감.","englishExpression":"gulleongsoe; hoop","englishDescription":"A round-shaped toy made with iron, played by putting a stick into the gap of the borders and rolling.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=37548&nation=eng&nationCode=6"},{"id":"krdict:80133:1","headword":"테","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"틀어지거나 깨지지 않도록 물건의 몸통에 단단히 둘러맨 줄.","englishExpression":"hoop; frame","englishDescription":"A rope, etc., that is fastened around the body of an object, so that it is not twisted or broken.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=80133&nation=eng&nationCode=6"}],"naivety":[{"id":"krdict:65127:2","headword":"순진","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"세상 물정을 잘 몰라 어수룩함.","englishExpression":"naivety","englishDescription":"The quality of being naïve because of lack of experience of life or worldliness.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=65127&nation=eng&nationCode=6"}],"outmoded":[{"id":"krdict:36383:1","headword":"구시대적","partOfSpeech":"determiner","partOfSpeechKo":"관형사","definitionKo":"예전 시대에만 있거나 새로운 시대에 맞지 않게 오래된.","englishExpression":"outdated; outmoded","englishDescription":"Existing in the old days only or becoming too old for a new era.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=3638