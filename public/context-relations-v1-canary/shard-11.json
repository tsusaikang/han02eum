SearchView?ParaWordNo=40425&nation=eng&nationCode=6"},{"id":"krdict:68467:1","headword":"완만하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"일 등이 되어 가는 속도가 늦다.","englishExpression":"sluggish","englishDescription":"A task, etc., proceeding slowly.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=68467&nation=eng&nationCode=6"},{"id":"krdict:68472:1","headword":"완만하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"움직임이 느리다.","englishExpression":"sluggish","englishDescription":"A movement being slow.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=68472&nation=eng&nationCode=6"},{"id":"krdict:77356:1","headword":"지지부진하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"일 등이 잘 진행되지 못하고 매우 더디다.","englishExpression":"slow; sluggish","englishDescription":"Work, etc., progressing slowly.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=77356&nation=eng&nationCode=6"},{"id":"krdict:79006:1","headword":"찌뿌드드하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"몸살이나 감기로 몸이 무거워서 움직임이 자연스럽지 못하다.","englishExpression":"sluggish","englishDescription":"One's body movement being awkward and slow due to a flu or cold.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=79006&nation=eng&nationCode=6"},{"id":"krdict:85694:2","headword":"둔하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"움직임이 무겁고 느리다.","englishExpression":"sluggish; inactive","englishDescription":"A movement being heavy and slow.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=85694&nation=eng&nationCode=6"}],"ttwari":[{"id":"krdict:53118:1","headword":"똬리","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"짚이나 천으로 만들어 짐을 머리 위에 일 때 머리에 받치는 고리 모양의 물건.","englishExpression":"ttwari","englishDescription":"A ring-shaped item made of straw or cloth that is placed on the head to carry things on it.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=53118&nation=eng&nationCode=6"}]}}
