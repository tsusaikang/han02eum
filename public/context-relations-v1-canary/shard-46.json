orean.go.kr/eng/dicSearch/SearchView?ParaWordNo=30872&nation=eng&nationCode=6"},{"id":"krdict:64065:1","headword":"수괴","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"나쁜 짓을 하는 무리의 우두머리.","englishExpression":"ringleader; boss","englishDescription":"The head of a group that does bad things.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=64065&nation=eng&nationCode=6"},{"id":"krdict:68023:1","headword":"왕초","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"(속된 말로) 거지나 불량배의 우두머리.","englishExpression":"boss; ringleader","englishDescription":"(slang) The leader of beggars or gangsters.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=68023&nation=eng&nationCode=6"},{"id":"krdict:69601:1","headword":"원흉","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"못된 짓을 한 무리의 우두머리.","englishExpression":"ringleader","englishDescription":"The head of a group who did a bad thing.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=69601&nation=eng&nationCode=6"},{"id":"krdict:83317:2","headword":"대장","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"(놀리는 말로) 어떤 일을 잘하거나 많이 하는 사람.","englishExpression":"king; master; ringleader; bully","englishDescription":"(teasing) A person who does something well or frequently.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=83317&nation=eng&nationCode=6"}],"stately":[{"id":"krdict:51012:1","headword":"덩그렇다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"홀로 우뚝 솟아 드러나 있다.","englishExpression":"stately; imposing","englishDescription":"Towering high above while attracting attention.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=51012&nation=eng&nationCode=6"},{"id":"krdict:68956:1","headword":"우람스럽다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"매우 크고 웅장한 데가 있다.","englishExpression":"stately; imposing","englishDescription":"Very big and grand.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=68956&nation=eng&nationCode=6"},{"id":"krdict:69636:1","headword":"위엄스럽다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"존경할 만한 지위와 권세가 있어 엄숙한 태도나 분위기가 있다.","englishExpression":"dignified; majestic; stately","englishDescription":"Having a dignified attitude or image because one has respectable power in a respectable position.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=69636&nation=eng&nationCode=6"},{"id":"krdict:90345:1","headword":"으리으리하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"모양이나 규모가 굉장하다.","englishExpression":"imposing; grand; stately","englishDescription":"The shape or size of something being amazing.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=90345&nation=eng&nationCode=6"}]}}
