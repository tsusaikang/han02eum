3&nation=eng&nationCode=6"},{"id":"krdict:54161:1","headword":"뚜껑","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"그릇이나 상자, 펜 등의 열린 윗부분을 덮거나 막는 물건.","englishExpression":"lid","englishDescription":"A thing that is used for closing the opening at the top of a container, box, pen, etc.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=54161&nation=eng&nationCode=6"},{"id":"krdict:83130:2","headword":"캡","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"만년필 등 필기도구의 뚜껑.","englishExpression":"lid","englishDescription":"The lid of a writing instrument such as a fountain pen, etc.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=83130&nation=eng&nationCode=6"}],"low-spirited":[{"id":"krdict:26654:1","headword":"우울하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"걱정 등으로 마음이 답답하여 활발한 기운이 없다.","englishExpression":"low-spirited; melancholy; blue","englishDescription":"Feeling frustrated and cheerless due to worries, etc.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=26654&nation=eng&nationCode=6"}],"mainland":[{"id":"krdict:60162:1","headword":"본토","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"딸린 섬, 식민지, 피보호국 등에 대하여 주가 되는 국토.","englishExpression":"mainland","englishDescription":"The main part of a country excluding its islands, colonies, and protectorates.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=60162&nation=eng&nationCode=6"}],"millstone":[{"id":"krdict:55115:1","headword":"맷돌","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"둥글넓적한 두 돌 사이에 곡식을 넣고 손잡이를 돌려서 곡식을 가는 데 쓰는 기구.","englishExpression":"millstone","englishDescription":"Stones used to grind grains by putting grains in between two round, flat stones and turning the handle.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=55115&nation=eng&nationCode=6"}],"naturalize":[{"id":"krdict:34977:1","headword":"귀화