{"version":"context-relations-v1-canary","words":{"cheongmyeong":[{"id":"krdict:69043:1","headword":"청명","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"일 년 중 날이 가장 맑다는 때로 이십사절기의 하나. 4월 5일경이다. 한 해의 농사가 시작된다고 해서 중요한 날로 여겨졌다.","englishExpression":"cheongmyeong","englishDescription":"One of the 24 seasonal divisions, said to be the day when the weather is the clearest of the year; the day falls around April 5th; it is considered as an important day as a year's farming is said to begin on this day.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=69043&nation=eng&nationCode=6"}],"cumulus":[{"id":"krdict:57108:1","headword":"뭉게구름","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"솜을 쌓아 놓은 것 같이 생긴 큰 구름.","englishExpression":"cumulus","englishDescription":"A large cloud shaped like cotton stacked up.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=57108&nation=eng&nationCode=6"}],"fathom":[{"id":"krdict:79018:3","headword":"측량하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"생각하여 헤아리다.","englishExpression":"fathom; think over","englishDescription":"To think about and consider something.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=79018&nation=eng&nationCode=6"},{"id":"krdict:90943:1","headword":"뜨다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"상대편의 속마음을 알아보려고 가만히 어떤 말이나 행동을 하다.","englishExpression":"guess; sound; fathom","englishDescription":"To say or do something to find out what the other person has in mind.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=90943&nation=eng&nationCode=6"}],"frenzy":[{"id":"krdict:30711:1","headword":"광란","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"미친 듯이 어지럽게 날뜀.","englishExpression":"craze; frenzy","englishDescription":"The act of behaving or running about in a crazy, giddy fashion.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=30711&nation=eng&nationCode=6"},{"id":"krdict:30822:2","headword":"광풍","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"(비유적으로) 갑자기 또는 무섭게 일어나는 기운이나 기세.","englishExpression":"craze; frenzy","englishDescription":"(figurative) A strong and sudden surge of spirit or force.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=30822&nation=eng&nationCode=6"}],"often":[{"id":"krdict:40481:2","headword":"늘","partOfSpeech":"adverb","partOfSpeechKo":"부사","definitionKo":"평소에 자주.","englishExpression":"often","englishDescription":"Frequently, in ordinary times.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=40481&nation=eng&nationCode=6"},{"id":"krdict:58939:14","headword":"잘","partOfSpeech":"adverb","partOfSpeechKo":"부사","definitionKo":"성질이나 성향이 어떤 상태가 되거나 어떤 행동을 하기 쉽게.","englishExpression":"well; often","englishDescription":"With the nature or personality that easily leads someone or something to be in a certain state or act in a certain way.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=58939&nation=eng&nationCode=6"},{"id":"krdict:58939:9","headword":"잘","partOfSpeech":"adverb","partOfSpeechKo":"부사","definitionKo":"버릇처럼 자주.","englishExpression":"often","englishDescription":"Habitually and frequently.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=58939&nation=eng&nationCode=6"},{"id":"krdict:71199:1","headword":"자주","partOfSpeech":"adverb","partOfSpeechKo":"부사","definitionKo":"같은 일이 되풀이되는 간격이 짧게.","englishExpression":"often; frequently","englishDescription":"In the state of something being repeated at short intervals.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=71199&nation=eng&nationCode=6"},{"id":"krdict:73183:1","headword":"자주자주","partOfSpeech":"adverb","partOfSpeechKo":"부사","definitionKo":"같은 일이 잇따라 매우 잦게.","englishExpression":"often; frequently","englishDescription":"In the state of something being r