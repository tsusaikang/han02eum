":"동의","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"다른 사람의 행위를 승인함.","englishExpression":"approval; permission","englishDescription":"An approval on another person's action.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=14813&nation=eng&nationCode=6"},{"id":"krdict:65897:1","headword":"승낙","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"남이 부탁하는 것을 들어줌.","englishExpression":"approval; consent; permission","englishDescription":"The act of accepting another's request.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=65897&nation=eng&nationCode=6"},{"id":"krdict:72276:1","headword":"인허","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"인정하여 허가함.","englishExpression":"authorization; permission; approval","englishDescription":"An act of recognizing and permitting something.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=72276&nation=eng&nationCode=6"},{"id":"krdict:72945:1","headword":"인가","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"인정하여 허가함.","englishExpression":"authorization; permission; approval","englishDescription":"An act of giving an official permission to someone.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=72945&nation=eng&nationCode=6"},{"id":"krdict:85108:1","headword":"허가","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"행동이나 일을 할 수 있게 허락함.","englishExpression":"permission; approval","englishDescription":"The act of allowing someone to perform a certain act or task.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=85108&nation=eng&nationCode=6"},{"id":"krdict:85108:2","headword":"허가","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"법에 의해 금지되어 있는 행위를 특정한 경우에 한해 허용하여 이를 행할 수 있게 함.","englishExpression":"permission; authorization","englishDescription":"The act of allowing someone to perform certain acts forbidden by law, only in certain special cases.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=85108&nation=eng&nationCode=6"},{"id":"krdict:86945:1","headword":"허락","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"요청하는 일을 하도록 들어줌.","englishExpression":"approval; consent; permission","englishDescription":"The act of accepting another's request.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=86945&nation=eng&nationCode=6"},{"id":"krdict:87918:1","headword":"허용","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"문제 삼지 않고 허락하여 받아들임.","englishExpression":"permission; allowing","englishDescription":"An act of allowing and accepting something without raising any question to it.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=87918&nation=eng&nationCode=6"}],"tiger":[{"id":"krdict:59030:1","headword":"범","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"누런 갈색의 몸에 검은 줄무늬가 있고, 다른 동물을 잡아먹고 사는 몸집이 큰 동물. 호랑이.","englishExpression":"tiger; tigress","englishDescription":"A big animal preying on other animals, which has black stripes all over its yellowish brown body.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=59030&nation=eng&nationCode=6"},{"id":"krdict:74128:1","headword":"호랑이","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"누런 갈색의 몸에 검은 줄무늬가 있고, 다른 동물을 잡아먹고 사는 몸집이 큰 동물.","englishExpression":"tiger","englishDescription":"A big, carnivorous animal that has yellowish brown coat and black stripes.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=74128&nation=eng&nationCode=6"}],"whitish":[{"id":"krdict:88486:1","headword":"희끄무레하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"생김새가 깨끗하고 빛깔이 조금 희다.","englishExpression":"whitish; fair","englishDescription":"One's appearance being neat and clean, and color being slightly white.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=88486&nation=eng&nationCode=6"},{"id":"krdict:88488:1","headword":"희끔하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"조금 희고 깨끗하다.","englishExpression":"whitish","englishDescription":"Slightly white and clear.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=88488&nation=eng&nationCode=6"}]}}
