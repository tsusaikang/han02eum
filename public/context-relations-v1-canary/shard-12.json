8&nation=eng&nationCode=6"},{"id":"krdict:60069:1","headword":"복창하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"남의 명령이나 말을 그대로 받아서 되풀이하다.","englishExpression":"repeat","englishDescription":"To repeat what someone has ordered or said.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=60069&nation=eng&nationCode=6"},{"id":"krdict:61515:1","headword":"반복하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"같은 일을 여러 번 계속하다.","englishExpression":"repeat","englishDescription":"To do the same work several times.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=61515&nation=eng&nationCode=6"},{"id":"krdict:74435:1","headword":"재현","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"다시 나타남. 또는 다시 나타냄.","englishExpression":"repeat; reenactment","englishDescription":"The act of appearing or creating something again.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=74435&nation=eng&nationCode=6"}],"sagunja":[{"id":"krdict:62039:1","headword":"사군자","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"동양화에서 매화, 난초, 국화, 대나무를 그린 그림.","englishExpression":"sagunja","englishDescription":"A painting of the plum, orchid, chrysanthemum and bamboo in Oriental painting.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=62039&nation=eng&nationCode=6"}],"thoughtless":[{"id":"krdict:14329:2","headword":"얕다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"생각이나 마음이 신중하거나 너그럽지 못하다.","englishExpression":"shallow; thoughtless; imprudent","englishDescription":"One's thinking or mind being not careful or generous.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=14329&nation=eng&nationCode=6"},{"id":"krdict:26788:5","headword":"가볍다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"생각이나 말, 행동 등이 신중하지 않고 침착하지 못하다.","englishExpression":"thoughtless; careless; rash","englishDescription":