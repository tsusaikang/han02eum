echKo":"형용사","definitionKo":"흥미나 의욕이 없어 지루하고 심심하다.","englishExpression":"bored","englishDescription":"Being bored and tired because one has no interest or desire.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=55292&nation=eng&nationCode=6"}],"bright":[{"id":"krdict:15186:2","headword":"똑똑하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"머리가 좋고 영리하다.","englishExpression":"clever; bright; sensible","englishDescription":"Intelligent and wise.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=15186&nation=eng&nationCode=6"},{"id":"krdict:30718:1","headword":"광명하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"밝고 환하다.","englishExpression":"bright","englishDescription":"Light and brilliant.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=30718&nation=eng&nationCode=6"},{"id":"krdict:30718:2","headword":"광명하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"(비유적으로) 미래가 밝거나 희망적이다.","englishExpression":"bright; promising","englishDescription":"(figurative) The future being rosy and hopeful.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=30718&nation=eng&nationCode=6"},{"id":"krdict:53091:1","headword":"똘똘하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"주로 어린아이가 매우 똑똑하고 영리하다.","englishExpression":"smart; bright","englishDescription":"Usually a child being very smart and clever.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=53091&nation=eng&nationCode=6"},{"id":"krdict:55272:1","headword":"명랑하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"유쾌하고 활발하다.","englishExpression":"bright; cheerful; merry","englishDescription":"Being pleasant and full of life.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=55272&nation=eng&nationCode=6"},{"id":"krdict:59111:6","headword":"번하다","partOfSpeech":"adjective","par