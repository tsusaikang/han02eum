echKo":"부사","definitionKo":"약간 넓은 범위를 한 바퀴 도는 모양.","englishExpression":"round; around","englishDescription":"In the manner of going around in a slightly wider circle.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=85207&nation=eng&nationCode=6"},{"id":"krdict:85211:1","headword":"핑그르르","partOfSpeech":"adverb","partOfSpeechKo":"부사","definitionKo":"넓게 원을 그리며 도는 모양.","englishExpression":"around; round","englishDescription":"In the manner of spinning around in a wide circle.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=85211&nation=eng&nationCode=6"},{"id":"krdict:89044:1","headword":"한차례","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"어떤 일이 한바탕 일어남을 나타내는 말.","englishExpression":"bout; spell; round; flurry","englishDescription":"A state in which a certain event takes place once on a large scale.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=89044&nation=eng&nationCode=6"}],"saekdong-ot":[{"id":"krdict:63673:1","headword":"색동옷","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"색동의 옷감을 대서 만든 옷.","englishExpression":"saekdong-ot","englishDescription":"rainbow-striped garment: Clothes made by using lots of different colors.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=63673&nation=eng&nationCode=6"}],"thigh":[{"id":"krdict:41146:1","headword":"넓적다리","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"무릎 위쪽의 다리.","englishExpression":"thigh","englishDescription":"The part of the leg above the knee.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=41146&nation=eng&nationCode=6"},{"id":"krdict:87718:1","headword":"허벅지","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"허벅다리 안쪽의 살이 깊은 곳.","englishExpression":"thigh","englishDescription":"The thick-fleshy part of the inside the thigh.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=87718&nation=eng&nationC