=25109&nation=eng&nationCode=6"},{"id":"krdict:25109:3","headword":"전개하다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"넓거나 길게 펼치다.","englishExpression":"unfold; expand","englishDescription":"To spread out in width or length.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=25109&nation=eng&nationCode=6"},{"id":"krdict:88045:2","headword":"펼치다","partOfSpeech":"verb","partOfSpeechKo":"동사","definitionKo":"접히거나 포개진 것을 넓게 펴다.","englishExpression":"unfold; unroll; spread out","englishDescription":"For something folded or overlapped to be spread widely.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=88045&nation=eng&nationCode=6"}],"vineyard":[{"id":"krdict:83351:1","headword":"포도밭","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"포도를 심어 기르는 밭.","englishExpression":"vineyard; vinery","englishDescription":"A yard where grapes are planted and grown.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=83351&nation=eng&nationCode=6"}]}}
