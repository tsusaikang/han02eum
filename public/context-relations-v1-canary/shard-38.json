Code=6"}],"prosaist":[{"id":"krdict:61765:1","headword":"산문가","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"산문을 잘 쓰는 사람.","englishExpression":"prose writer; prosaist","englishDescription":"A person who writes prose well.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=61765&nation=eng&nationCode=6"}],"rack":[{"id":"krdict:63137:1","headword":"선반","partOfSpeech":"noun","partOfSpeechKo":"명사","definitionKo":"물건 등을 올려 두기 위해 벽에 달아 놓은 긴 널빤지.","englishExpression":"shelf; rack","englishDescription":"A long board hung on the wall in order to place objects, etc.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=63137&nation=eng&nationCode=6"}],"sound":[{"id":"krdict:15902:1","headword":"건전하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"생각이나 의식, 분위기 등이 어둡지 않고 올바르다.","englishExpression":"sound; healthy","englishDescription":"An atmosphere, behavior, mindset, etc. is right, not wrong or dark.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=15902&nation=eng&nationCode=6"},{"id":"krdict:23925:1","headword":"건실하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"태도나 생각, 말 등이 올바르다.","englishExpression":"sound; reliable","englishDescription":"One's attitude, remarks, thoughts, etc., being upright and honorable.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=23925&nation=eng&nationCode=6"},{"id":"krdict:29703:1","headword":"견실하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"믿을 수 있을 만큼 실속이 있고 튼튼하다.","englishExpression":"sound; reliable","englishDescription":"Solid and strong enough to be trusted.","sourceUrl":"https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=29703&nation=eng&nationCode=6"},{"id":"krdict:50551:3","headword":"든든하다","partOfSpeech":"adjective","partOfSpeechKo":"형용사","definitionKo":"믿을 수 있을 정도로 속이 실하다.","englishExpression":"sound; secure; solid","englishDescription":"Re