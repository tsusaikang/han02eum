@@ -0,0 +1,36 @@
+"""Render explicit legacy Korean link/label arguments without incompatible Lua aliases."""
+from mediawiki_langcodes import code_to_name
+from ...page import clean_node as clean_core
+
+def clean_node(wxr, sense_data, wikinode, template_fn=None, **kwargs):
+    def legacy_template(name, args):
+        first = str(args.get(1, '')).strip()
+        if name == '연결' and first and not code_to_name(first, 'en'):
+            # Legacy {{연결|표제어|언어=...}} uses the first parameter as text.
+            if 2 not in args:
+                return '[[' + first + ']]'
+        if name in ('plural of', 'inflection of', 'infl of') and code_to_name(first, 'en') and args.get(2):
+            # The dump's form-of Lua calls methods on a module-name string.
+            # Preserve explicit lemma and grammatical codes without inventing
+            # a Korean definition or depending on that broken implementation.
+            lemma = str(args[2])
+            if name == 'plural of':
+                return 'Plural of [[' + lemma + ']]'
+            codes = [str(args[k]) for k in sorted(k for k in args if isinstance(k, int) and k >= 4) if str(args[k]).strip()]
+            return 'Inflection of [[' + lemma + ']]' + (' (' + ', '.join(codes) + ')' if codes else '')
+        if name == '웹 인용'  and args.get('url'):
+            title = str(args.get('제목') or args.get('title') or args['url'])
+            return '[' + str(args['url']) + ' ' + title + ']'
+        if name == '예문' and '언어' in args:
+            return str(args.get(1, '')) + (' — ' + str(args[2]) if args.get(2) else '')
+        return template_fn(name, args) if template_fn else None
+    previous_post = kwargs.pop('post_template_fn', None)
+    def legacy_post(name, args, expanded):
+        first = str(args.get(1, '')).strip()
+        if name == '라벨' and 'class="error"' in expanded:
+            start = 2 if code_to_name(first, 'en') else 1
+            labels = [str(args[k]).strip() for k in sorted(k for k in args if isinstance(k, int) and k >= start) if str(args[k]).strip()]
+            if labels:
+                return '(' + ', '.join(labels) + ')'
+        return previous_post(name, args, expanded) if previous_post else None
+    return clean_core(wxr, sense_data, wikinode, template_fn=legacy_template, post_template_fn=legacy_post, **kwargs)
