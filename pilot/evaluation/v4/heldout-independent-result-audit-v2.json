  "findings": [
    {
      "id": "P1-001",
      "priority": "P1",
      "title": "The provider gate trusts caller-supplied gold and can normalize a negative approval escape into the expected baseline.",
      "evidence": [
        "buildHeldoutAttemptPlan accepts orderedCore and gold objects from its caller, computes the expected fingerprint from the supplied core, and copies semanticGold and publicationEligible from the supplied gold entry.",
        "It does not bind those objects to heldout-consensus-v2.json, heldout-gold-v2.json, heldout-result-seal-v2.json, or a successful admission/result-audit proof, and it does not independently re-derive semanticGold or publicationEligible.",
        "evaluateProviderHeldoutGate rebuilds its expected plan from the same caller-supplied objects, so coordinated or accidental expected-input mutation becomes the comparison baseline rather than a failure.",
        "A synthetic check left v2-case-02's sealed disjoint/fail normative core unchanged but changed its in-memory gold from negative/publication false to positive/publication true. The generated 60 attempts passed, all six v2-case-02 attempts had finalApproval=true, and negativeApprovalEscapeCount remained zero."
      ],
      "impact": "A future runner can obtain a passing held-out gate after a false-to-true semantic-label and approval mutation for a sealed semantic-negative case. Full normative fingerprints can still match while the zero-negative-escape and veto-only result contracts are defeated.",
      "requiredRemediation": [
        "Derive semanticGold and publicationEligible inside the gate from an exact admitted ordered core plus sealed evidence, or require and validate exact consensus/gold/result-seal SHA bindings before building the expected plan.",
        "Reject any supplied gold case whose identity, normative fingerprint, semanticGold, publicationEligible, expected final approval, or veto axes differ from independent derivation.",
        "Bind provider authorization and gate evaluation to the exact successful admission and independent result-audit artifact rather than accepting only caller booleans and mutable objects.",
        "Add regression tests that mutate expected gold and ordered core independently and require fail-closed behavior before resealing the changed code and test artifacts."
      ],
      "blocksGo": true
    },
    {
      "id": "P2-001",
      "priority": "P2",
      "title": "Mismatch summary counts can report 60 matches when one expected attempt is missing and one unexpected attempt is skipped.",
      "evidence": [
        "evaluateProviderHeldoutGate skips unexpected attempt IDs when checking fingerprints and labels.",
        "Its match counts are calculated as observedAttempts.length minus mismatch count, so skipped unexpected attempts are counted as matches.",
        "A 60-item set with one missing expected ID and one unique unexpected ID correctly failed but reported fullFingerprintMatchCount=60 and semanticGoldMatchCount=60 although only 59 expected attempts were evaluated."
      ],
      "impact": "The gate remains fail-closed because ATTEMPT_MISSING and ATTEMPT_UNEXPECTED are recorded, but downstream summaries can overstate exact-match coverage and confuse audit review.",
      "recommendedRemediation": [
        "Count matches only for expected IDs that were actually evaluated and passed the corresponding comparison.",
        "Add an unexpected-attempt regression test that asserts both the failure and accurate match denominators."
      ],
      "blocksGo": false
    }
  ],
