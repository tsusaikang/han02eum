  "$defs": {
    "usageValue": {
      "enum": [
        "match",
        "source-only-preservable",
        "target-only",
        "conflict",
        "not-applicable",
        "unknown"
      ]
    },
    "usageCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register",
        "domain",
        "temporal",
        "regional",
        "capitalization"
      ],
      "properties": {
        "register": {"$ref": "#/$defs/usageValue"},
        "domain": {"$ref": "#/$defs/usageValue"},
        "temporal": {"$ref": "#/$defs/usageValue"},
        "regional": {"$ref": "#/$defs/usageValue"},
        "capitalization": {"$ref": "#/$defs/usageValue"}
      }
    },
    "semanticCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRelationToSource"
      ],
      "properties": {
        "targetRelationToSource": {
          "enum": [
            "exact",
            "broader",
            "narrower",
            "overlap",
            "disjoint"
          ]
        }
      }
    },
    "exampleCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "evaluatedSourceExampleIds",
        "targetSenseAttested",
        "counterexampleSourceExampleId"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "insufficient"
          ]
        },
        "evaluatedSourceExampleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "targetSenseAttested": {"type": "boolean"},
        "counterexampleSourceExampleId": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"verdict": {"const": "pass"}},
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "targetSenseAttested": {"const": true},
              "counterexampleSourceExampleId": {"const": null}
            }
          }
        },
        {
          "if": {
            "properties": {"verdict": {"const": "fail"}},
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "targetSenseAttested": {"const": true},
              "counterexampleSourceExampleId": {"type": "string"}
            }
          }
        },
        {
          "if": {
            "properties": {"verdict": {"const": "insufficient"}},
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "targetSenseAttested": {"const": false},
              "counterexampleSourceExampleId": {"const": null}
            }
          }
        }
      ]
    },
    "caseCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "sourceId",
        "targetId",
        "semantic",
        "usage",
        "example"
      ],
      "properties": {
        "caseId": {"type": "string"},
        "sourceId": {"type": "string"},
        "targetId": {"type": "string"},
        "semantic": {"$ref": "#/$defs/semanticCore"},
        "usage": {"$ref": "#/$defs/usageCore"},
        "example": {"$ref": "#/$defs/exampleCore"}
      }
