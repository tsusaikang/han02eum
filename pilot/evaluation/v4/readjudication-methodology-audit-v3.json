  "findings": [
    {
      "id": "RDMA3-P1-001",
      "severity": "P1",
      "title": "HV4-05 and HV4-07 mistake proper-name capitalization for sense-level English usage evidence",
      "affectedCases": ["HV4-05", "HV4-07"],
      "affectedArtifacts": [
        "docs/AI_MAPPING_V4_READJUDICATION_PREREGISTRATION_V3.md",
        "pilot/evaluation/v4/readjudication-instructions-v3.md",
        "pilot/evaluation/v4/readjudication-schema-v3.json",
        "pilot/evaluation/v4/readjudication-protocol-seal-v3.json"
      ],
      "evidence": [
        "HV4-05 has no capitalization qualifier or sense label. Railway Interest is a quoted name for a specific historical lobby, and the same sense's other usable evidence is lowercase: the iron interest; the cotton interest.",
        "HV4-07 has only the geography qualifier and a lowercase source headword and definition. Every uppercase Sound token occurs inside a proper geographic name: Puget Sound, Owen Sound, Long Island Sound, or The Sound of Denmarke.",
        "The fixed rule requires actual source sense-level capitalization information. It expressly excludes treating ordinary proper-name or incidental example capitalization as a Korean-target usage restriction."
      ],
      "impact": "The schema forcibly converts absent sense-level capitalization evidence into source-only-preservable for two cases. C and D cannot correct the values, the controlled fingerprints are wrong by construction, and an unknown usage veto is removed before gold derivation.",
      "requiredDisposition": "Keep v3 blank forms and execution prohibited. Preserve v3 unchanged and create a new sealed version setting HV4-05 and HV4-07 capitalization to unknown, with all ten case constants rechecked against sense-level evidence before another independent audit."
    }
  ],
